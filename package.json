{
  "name": "tunes-converter",
  "productName": "Tunes Converter",
  "version": "2.5.0",
  "description": "Convert folders of music to MP3, AAC, FLAC, WAV, AIFF or Opus with correct Artist - Title names and an optional fake-quality check.",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "author": "bobojuice",
  "homepage": "https://github.com/bobojuice/tunes-converter",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "io.github.bobojuice.tunesconverter",
    "productName": "Tunes Converter",
    "artifactName": "TunesConverter-${version}-legacy-${os}-${arch}.${ext}",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraFiles": [
        {
          "to": "bin",
          "from": "resources-win/bin"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tunes Converter",
      "artifactName": "TunesConverter-${version}-win-x64-setup.${ext}",
      "allowElevation": false
    },
    "mac": {
      "category": "public.app-category.music",
      "minimumSystemVersion": "10.13.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "synopsis": "Convert music folders to MP3, FLAC, WAV, AIFF and more"
    },
    "afterPack": "build/afterPack.js",
    "electronLanguages": [
      "en-US"
    ]
  },
  "devDependencies": {
    "electron": "26.6.10",
    "electron-builder": "^26.18.0"
  }
}
